{
  "name": "bs-maputility",
  "type": "module",
  "version": "3.0.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "ng serve --host 0.0.0.0 --port 4321",
    "start": "npm run dev",
    "build": "ng build",
    "preview": "ng serve --configuration production --host 0.0.0.0 --port 4321",
    "preview:static": "sirv dist/angular --host 127.0.0.1 --port 4322",
    "check": "ngc -p tsconfig.app.json --noEmit",
    "test": "node --experimental-strip-types --test src/app/tools/color-picker/color-formats.test.mjs",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "ng": "ng"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "bsmap": "^3.0.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "prettier": "^3.9.9",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0.3"
  }
}
